{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "react-jsx",
		"noEmit": false,
		"outDir": "dist",
		"rootDir": ".",
		"types": ["node", "electron"],
		"paths": {
			"@pi/desktop-shared/*": ["./shared/*"],
			"@earendil-works/pi-coding-agent": ["../../packages/coding-agent/dist/index.d.ts"]
		}
	},
	"include": ["electron/**/*.ts", "electron/**/*.cts", "shared/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
